<IfModule mod_rewrite.c>
    Options +FollowSymlinks
    RewriteEngine On

    # www -> apex over HTTPS. Trailing slashes are removed in PHP so the
    # redirect target is always https://<domain> and not the internal http
    # connection behind the proxy.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # Existing files are served as-is. That includes search-engine
    # verification files (google*.html, BingSiteAuth.xml) and a static
    # robots.txt or sitemap.xml, which override the generated routes.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([\s\S]*)$ index.php/$1 [L,NC,QSA]

    # Ensure Authorization header is passed along
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 index.php
</IfModule>

ServerSignature Off

<IfModule mod_php.c>
    php_flag expose_php Off
</IfModule>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|gif|ico|woff2?)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
